{
  "name": "winplayer",
  "version": "1.7.4",
  "private": true,
  "type": "module",
  "description": "A plugin-driven music player with WinUI design, built with Tauri 2 and Vue 3",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/ensure-icon-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-icon-fonts.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "android:icons": "node scripts/apply-android-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@applemusic-like-lyrics/vue": "^0.6.0",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@vue/devtools-api": "^8.0.0",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lucide-vue-next": "0.577.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
