{
  "name": "winplayer",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "A plugin-driven music player with WinUI design, built with Tauri 2 and Vue 3",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/ensure-icon-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-icon-fonts.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "android:icons": "node scripts/apply-android-icons.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@vue/devtools-api": "^8.0.0",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lucide-vue-next": "0.577.0",
    "mdui": "2.1.5",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fontsource/material-icons": "5.3.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "playwright": "1.56.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
