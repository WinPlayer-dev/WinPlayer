# --- Tauri / Rust ---
# 不带路径前缀 → 匹配任意层级的 target/ 目录（含 tauri-plugin-*/ 等 vendored 子 crate 的构建产物）
target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/nsis/
*.pdb

# --- Tests / coverage ---
coverage/
.nyc_output/

# --- Env ---
.env
.env.*
!.env.example

# --- Android debug keystore（签名密钥，禁止入库）---
debug.keystore
debug.keystore.b64

# 只忽略仓库根目录的插件产物目录；不要写成裸 `plugins/`，否则会连
# `src/views/plugins/` 这类源码目录一起忽略（曾导致 BuiltinSourcesTab.vue 未入库、CI 构建失败）
/plugins/
/plugins/*.zip

# --- 图标字体（prebuild 脚本自动下载，不入库）---
src/assets/fonts/*.ttf

.editorconfig
# 依赖锁文件不入库（vendored 子 crate 的 Cargo.lock 按此忽略）
Cargo.lock

.trae/

